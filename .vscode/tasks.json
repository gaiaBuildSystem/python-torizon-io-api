{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "download-spec",
            "hide": true,
            "command": "curl",
            "type": "shell",
            "args": [
                "-o",
                "${workspaceFolder}/torizon-openapi.yaml",
                "https://app.torizon.io/api/docs/torizon-openapi.yaml"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": "build"
        },
        {
            "label": "pull",
            "command": "docker",
            "type": "shell",
            "args": [
                "pull",
                "openapitools/openapi-generator-cli:latest"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": "build"
        },
        {
            "label": "generate",
            "command": "${workspaceFolder}/scripts/generate.sh",
            "type": "shell",
            "problemMatcher": [
                "$tsc"
            ],
            "presentation": {
                "reveal": "always"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "pull"
            ],
            "group": "build"
        },
        {
            "label": "build-package",
            "hide": false,
            "command": "poetry",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/generated"
            },
            "args": [
                "build"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": "build"
        },
        {
            "label": "push-pip-package",
            "hide": false,
            "command": "poetry",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/generated"
            },
            "args": [
                "run",
                "twine",
                "upload",
                "--config-file", "${workspaceFolder}/.pypirc",
                "dist/*"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "presentation": {
                "reveal": "always"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "build-package"
            ],
            "group": "build"
        },
        {
            "label": "create-generated-python-env",
            "hide": true,
            "command": "python",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/generated"
            },
            "args": [
                "-m",
                "venv",
                ".venv"
            ]
        },
        {
            "label": "install-generated-python-dependencies",
            "command": "${workspaceFolder}/generated/.venv/bin/python",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/generated"
            },
            "args": [
                "-m",
                "pip",
                "install",
                "-r",
                "../requirements.txt"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "create-generated-python-env"
            ]
        },
        {
            "label": "run-torizon-io",
            "command": "${workspaceFolder}/generated/.venv/bin/xonsh",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/generated${pathSeparator}${env:PYTHONPATH}"
                }
            },
            "args": [
                "-c",
                "import shlex, sys; script_path = sys.argv[-2]; sys.argv = [script_path, *shlex.split(sys.argv[-1])]; execx(open(script_path).read(), filename=script_path)",
                "torizon-io.xsh",
                "${input:torizon-io-arguments}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "install-generated-python-dependencies"
            ]
        }
    ],
    "inputs": [
        {
            "id": "torizon-io-arguments",
            "type": "promptString",
            "description": "Arguments for torizon-io.xsh",
            "default": "package list <package-name>"
        }
    ]
}
